# Example only. No live service is configured.
PORT=5001
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5174,http://127.0.0.1:5174
DIAGNOSTIC_WS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Azure Speech (speech-to-text, pronunciation assessment, neural text-to-speech).
# Backend only - never put these in a VITE_* variable. Key: Azure portal > your
# Speech resource > Keys and Endpoint (KEY 1). Region: that resource's Location/Region
# code, e.g. southeastasia. Without both, speech requests fail with SPEECH_NOT_CONFIGURED;
# there is no fallback provider.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Optional text-to-speech voices. Allowed EN: en-US-JennyNeural, en-US-GuyNeural,
# en-PH-RosaNeural, en-PH-JamesNeural. Allowed FIL: fil-PH-BlessicaNeural, fil-PH-AngeloNeural.
AZURE_SPEECH_VOICE_EN=en-US-JennyNeural
AZURE_SPEECH_VOICE_FIL=fil-PH-BlessicaNeural
# Optional per-operation deadline in milliseconds (5000-120000).
AZURE_SPEECH_TIMEOUT_MS=60000
# Do not start with inherited team service variables. dotenv does not override them.
# Signs M2 diagnostic transcripts so only server-produced Azure transcripts can be scored.
# Backend only, at least 32 random characters, identical on every backend instance.
# Without it, diagnostic uploads/streams and result saving fail closed (503).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
DIAGNOSTIC_RECEIPT_SECRET=
# M7 risk worker stays off until the M7 analytics migration is verified on the target database.
M7_RISK_WORKER_ENABLED=false
